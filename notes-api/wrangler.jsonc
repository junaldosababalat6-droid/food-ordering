{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food-ordering-notes-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-ordering-notes",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FRONTEND_ORIGINS": "https://junaldosababalat6-droid.github.io,http://localhost:5173"
  }
}
